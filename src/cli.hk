use host
use console
use buffers
namespace ito

class CliOptions
  public command: String = ""
  public project: String = "."
  public argument: String = ""
  public locked: Bool = false
  public release: Bool = false
  public timings: Bool = false
  public output: String = ""
  public executable: String = ""
  public error: String = ""
end

def cliOptions(): CliOptions
  let result = new CliOptions()
  var index = 0
  var literal = false
  while index < host::argumentCount()
    let argument = host::argumentAt(index)
    if argument == null
      result.error = "cannot read command arguments"
      return result
    end
    if !literal && argument == "--"
      literal = true
    else if !literal && argument == "--project"
      index = index + 1
      let path = host::argumentAt(index)
      if path == null || path == ""
        result.error = "--project requires a directory"
        return result
      end
      result.project = path
    else if !literal && argument == "--locked"
      result.locked = true
    else if !literal && argument == "--release"
      result.release = true
    else if !literal && argument == "--timings"
      result.timings = true
    else if !literal && argument == "--output"
      index = index + 1
      let output = host::argumentAt(index)
      if output == null || output == ""
        result.error = "--output requires a path"
        return result
      end
      result.output = output
    else if !literal && (argument == "--help" || argument == "-h")
      result.command = "help"
      return result
    else if !literal && argument == "--version"
      result.command = "version"
      return result
    else if !literal && host::stringByteLength(argument) > 0 && host::stringByteAt(argument, 0) == 45 as Byte
      result.error = "unknown option: " + argument
      return result
    else if result.command == ""
      result.command = argument
    else if result.argument == ""
      result.argument = argument
    else
      result.error = "too many command arguments"
      return result
    end
    index = index + 1
  end
  if result.command == ""
    result.command = "help"
  end
  if result.locked && result.command != "install"
    result.error = "--locked is only supported by install"
  end
  if result.release && !compilerCommand(result.command)
    result.error = "--release requires build, run or test"
  end
  if result.timings && !compilerCommand(result.command)
    result.error = "--timings requires build, run or test"
  end
  if result.output != "" && result.command != "build"
    result.error = "--output is only supported by build"
  end
  if (result.command == "install" || result.command == "list" || applicationCommand(result.command)) && result.argument != ""
    result.error = result.command + " does not accept a positional argument"
  end
  return result
end

def configuredHome(): String?
  let configured = host::environment("ITO_HOME")
  if configured != null && configured != ""
    return physicalPath(configured, true)
  end
  let home = host::environment("HOME")
  if home == null || home == ""
    return null
  end
  return physicalPath(home + "/.ito", true)
end

def initializePackage(project: String, name: String, initial: DocumentRead): String
  if !initial.missing
    return "package.json already exists"
  end
  var chosen = name
  if chosen == ""
    let parts = pathParts(project)
    if parts.Length > 0
      chosen = parts[parts.Length - 1]
    end
  end
  if !packageName(chosen)
    return "invalid package name; provide one with ito init <name>"
  end
  let manifest = jsonObject()
  manifest.add(jsonString(chosen, "name"))
  manifest.add(jsonString("0.1.0", "version"))
  let dependencies = jsonObject()
  dependencies.key = "dependencies"
  manifest.add(dependencies)
  let buffer = buffers::ByteBuffer.create(1048576)
  if buffer == null || !buffer.appendText(jsonPretty(manifest) + "\n")
    return "cannot encode package.json"
  end
  if fsBytes(2, project + "/package.json", "", buffer.snapshot()) != 0
    return "cannot create package.json without overwriting an existing file"
  end
  console::println("Created package.json for " + chosen)
  return ""
end

def listLocked(root: Json, lock: DocumentRead): String
  let document = lock.document
  if document == null
    if root.get("dependencies").first == null
      console::println("No dependencies.")
      return ""
    end
    return "ito.lock is missing; run ito install"
  end
  let error = validateLock(document, root)
  if error != ""
    return error
  end
  let packages = canonicalJson(document.get("packages"))
  var package = packages.first
  if package == null
    console::println("No dependencies.")
  end
  while package != null
    var relation = "transitive"
    if root.get("dependencies").get(package.key).kind != "missing"
      relation = "direct"
    end
    console::println(package.key + " " + package.get("version").value + " " + package.get("integrity").value + " (" + relation + ")")
    package = package.next
  end
  return ""
end

def packageCommand(options: CliOptions, project: String): String
  let initial = readDocument(project, "package.json")
  if initial.error != ""
    return initial.error
  end
  if options.command == "init"
    return initializePackage(project, options.argument, initial)
  end
  let original = initial.document
  if original == null
    return "package.json is missing; run ito init"
  end
  let manifestError = validateManifest(original)
  if manifestError != ""
    return manifestError
  end
  var locked = new DocumentRead()
  if !(options.command == "update" && options.argument == "")
    locked = readDocument(project, "ito.lock")
    if locked.error != ""
      return locked.error
    end
  end
  if options.command == "list"
    return listLocked(original, locked)
  end
  let home = configuredHome()
  if home == null
    return "cannot resolve ITO_HOME or HOME"
  end
  var root = original
  let selected = jsonArray()
  var declarationChanged = false
  if options.command == "add"
    if options.argument == ""
      return "usage: ito add <local-path>"
    end
    let origin = host::pathAbsolute(project + "/" + options.argument)
    if origin == null
      return "invalid dependency path"
    end
    let snapshot = readSnapshot(origin)
    let dependencyManifest = snapshot.manifest
    if snapshot.error != "" || dependencyManifest == null
      return "cannot add package: " + snapshot.error
    end
    let name = dependencyManifest.get("name").value
    let declaration = jsonObject()
    declaration.add(jsonString(relativePath(project, origin), "path"))
    root = objectWith(root, "dependencies", objectWith(declarationObject(root.get("dependencies")), name, declaration))
    selected.add(jsonString(name))
    declarationChanged = true
  else if options.command == "remove"
    let name = options.argument
    if name == "" || root.get("dependencies").get(name).kind == "missing"
      return "remove requires the name of a direct dependency"
    end
    root = objectWith(root, "dependencies", objectWithout(root.get("dependencies"), name))
    declarationChanged = true
  else if options.command == "update" && options.argument != ""
    selected.add(jsonString(options.argument))
  end
  let oldLock = locked.document
  var graph = new PackageGraph(root, project)
  if (options.command == "install" || applicationCommand(options.command)) && oldLock != null
    graph = restoreGraph(home, root, project, oldLock)
  else if options.command == "install" && options.locked
    return "ito.lock is missing; run ito install before using --locked"
  else if oldLock != null && (declarationChanged || (options.command == "update" && options.argument != ""))
    graph = updateGraph(home, root, project, oldLock, selected)
  else
    if options.command == "update" && options.argument != "" && root.get("dependencies").get(options.argument).kind == "missing"
      return "unknown direct dependency to update: " + options.argument
    end
    graph = resolveGraph(root, project)
  end
  if graph.error != ""
    return graph.error
  end
  let prospectiveLock = graphLock(graph)
  if prospectiveLock == null
    return "cannot persist an unresolved dependency graph"
  end
  let lockError = validateLockWrite(prospectiveLock, root)
  if lockError != ""
    return lockError
  end
  var nextManifest = ""
  if declarationChanged
    nextManifest = jsonPretty(root) + "\n"
    if host::stringByteLength(nextManifest) > 1048576
      return "updated package.json exceeds the 1 MiB document limit"
    end
  end
  let published = publishGraph(home, graph)
  if published != ""
    return published
  end
  if declarationChanged && writeAtomic(project + "/package.json", nextManifest) != 0
    return "cannot atomically write package.json"
  end
  if (options.command != "install" && !applicationCommand(options.command)) || oldLock == null
    let persisted = persistLock(project + "/ito.lock", graph)
    if persisted != ""
      return persisted
    end
  end
  if options.command == "prepare"
    return prepareApplicationView(home, graph).error
  end
  if compilerCommand(options.command)
    return buildApplication(options, project, home, graph)
  end
  console::println("Dependencies ready: " + project + "/ito.lock")
  return ""
end

def cliMain(): Int
  let options = cliOptions()
  if options.error != ""
    console::println("ito: " + options.error)
    return 2
  end
  if options.command == "help"
    console::println("Ito local package manager\nUsage: ito [--project directory] <command>\n\n  init [name]\n  add <local-path>\n  install [--locked]\n  update [name]\n  remove <name>\n  list\n  prepare\n  build [--release] [--timings] [--output path]\n  run [--release] [--timings]\n  test [--release] [--timings]\n  self-install [bin-directory]\n\nprepare refreshes application manifests without compiling.\nITO_HOME selects the shared cache. Paths passed to add are relative to the project.")
    return 0
  end
  if options.command == "version"
    console::println("ito 0.1.0-dev")
    return 0
  end
  if options.command == "self-install"
    let error = selfInstall(options.argument)
    if error != ""
      console::println("ito: " + error)
      return 1
    end
    return 0
  end
  if options.command != "init" && options.command != "add" && options.command != "install" && options.command != "update" && options.command != "remove" && options.command != "list" && !applicationCommand(options.command)
    console::println("ito: unknown command: " + options.command)
    return 2
  end
  let project = physicalPath(options.project, options.command == "init")
  if project == null
    console::println("ito: cannot resolve project directory")
    return 1
  end
  if fs(1, project + "/.neri/ito") != 0
    console::println("ito: cannot create local project metadata")
    return 1
  end
  let descriptor = lockProject(project + "/.neri/ito/project.lock")
  if descriptor < 0
    console::println("ito: project is locked by another operation or the lock cannot be opened")
    return 1
  end
  var error = packageCommand(options, project)
  if unlockProject(descriptor) != 0 && error == ""
    error = "cannot release project lock"
  end
  if error != ""
    console::println("ito: " + error)
    return 1
  end
  if options.executable != ""
    executeApplication(options.executable, project)
    console::println("ito: cannot execute compiled application")
    return 1
  end
  return 0
end
